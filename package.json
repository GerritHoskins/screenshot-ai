{
  "name": "screenshot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered screenshot analysis tool",
  "main": "dist/main/index.js",
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "dev": "npm run build:core && electron-vite dev",
    "build:core": "npm run build --workspace @gerrithoskins/screenshot-ai-core",
    "verify:core": "npm run verify:package --workspace @gerrithoskins/screenshot-ai-core",
    "verify:core:react-native": "node scripts/verify-core-react-native.cjs",
    "build": "npm run build:core && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w keytar",
    "verify:packaging": "node scripts/verify-packaging.cjs",
    "package": "npm run verify:packaging && electron-builder --publish never",
    "package:unsigned": "npm run package -- -c.mac.identity=null -c.mac.notarize=false -c.win.signExecutable=false",
    "lint": "eslint src apps packages tests *.config.*ts --ext .ts,.tsx,.mts",
    "typecheck": "npm run build:core && tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:unit": "npm run build:core && vitest run tests/unit",
    "test:core": "npm run build:core && vitest run core-package",
    "test:e2e": "npm run build && vitest run tests/e2e"
  },
  "dependencies": {
    "@gerrithoskins/screenshot-ai-core": "0.1.0",
    "keytar": "^7.9.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.screenshotai.app",
    "productName": "ScreenshotAI",
    "afterPack": "./scripts/verify-packaged-app.cjs",
    "directories": {
      "output": "release",
      "buildResources": "packaging"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.plist"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "npm@11.1.0"
}
