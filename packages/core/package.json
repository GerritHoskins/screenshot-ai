{
  "name": "@gerrithoskins/screenshot-ai-core",
  "version": "0.1.0",
  "description": "Portable screenshot analysis, provider clients, prompts, and validation for React Native, browsers, and Node.js.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "react-native": "./dist/esm/index.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/esm/",
    "dist/cjs/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GerritHoskins/screenshot-ai.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/GerritHoskins/screenshot-ai/issues"
  },
  "homepage": "https://github.com/GerritHoskins/screenshot-ai/tree/main/packages/core#readme",
  "keywords": [
    "screenshot",
    "image-analysis",
    "react-native",
    "openai",
    "anthropic",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --project tsconfig.esm.json --noEmit",
    "prepack": "npm run build",
    "verify:package": "node scripts/verify-package.cjs"
  }
}
